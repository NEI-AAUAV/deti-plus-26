# URL of the deployed Google Apps Script web app that receives registrations.
# Deploy the script in apps-script/ as a web app ("Execute as: Me",
# "Who has access: Anyone") and paste the /exec URL here.
#
# This value is public by design: it ships in the client bundle, exactly like
# the endpoint of any public form. Abuse is handled server side by the rate
# limiter and honeypot, not by hiding this URL.
#
# In CI/CD set it as a GitHub *Variable* (not a Secret) named
# NEXT_PUBLIC_SCRIPT_URL, so the build can read it.
NEXT_PUBLIC_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
